{
  "expo": {
    "name": "streak-keeper",
    "slug": "streak-keeper",
    "scheme": "streak-keeper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/shield-check.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/shield-check.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.streakkeeper",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/shield-check.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.streakkeeper",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/shield-check.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4037c3dd-fff9-4bdb-959a-2f6a71177374"
      }
    }
  }
}
